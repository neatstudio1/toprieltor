{
  "kind": "collectionType",
  "collectionName": "developers",
  "info": {
    "singularName": "developer",
    "pluralName": "developers",
    "displayName": "Застройщики",
    "description": "Компании-застройщики. Заполняются автоматически при импорте каталога — вручную обычно не редактируются."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "slug": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "name": {
      "type": "string",
      "required": true
    },
    "site_url": {
      "type": "string"
    },
    "logo": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "projects": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::project.project",
      "mappedBy": "developer"
    }
  }
}
